---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const repoUrl = 'https://github.com/MatheusBBarni/knot-node-tooling';

const features = [
  {
    number: '01',
    title: 'Package management',
    status: 'Available now',
    copy: 'npm-compatible installs with verified downloads, deterministic lockfiles, isolated dependency links, and a content-addressed store.',
    command: 'knot install',
  },
  {
    number: '02',
    title: 'TypeScript compiler',
    status: 'Available now',
    copy: 'Transform a supported TypeScript and JSX subset, follow imports, emit source maps, and leave execution to Node.js or the browser.',
    command: 'knot transpile src/index.ts',
  },
  {
    number: '03',
    title: 'Production bundler',
    status: 'In progress',
    copy: 'Complete module graphs, tree-shake reachable code, split chunks, and publish JavaScript, CSS, HTML, and assets atomically.',
    command: 'knot build src/main.ts',
  },
  {
    number: '04',
    title: 'Isolated test runner',
    status: 'Planned',
    copy: 'Coordinate Node.js workers for tests with deterministic sharding, snapshots, coverage, reports, and hard process deadlines.',
    command: 'knot test',
  },
];

const roadmap = [
  { phase: 'Now', title: 'A dependable core', copy: 'Verified installs, strict package visibility, compiler transforms, graph analysis, and deterministic output.' },
  { phase: 'Next', title: 'A complete build pipeline', copy: 'Broader syntax support, code splitting, CSS and asset handling, atomic production publication, and watch mode.' },
  { phase: 'Then', title: 'A test runner you can trust', copy: 'Native coordination with isolated Node.js workers, assertions, mocks, snapshots, coverage, and reporters.' },
];

const benchmarkRows = [
  { tool: 'Knot', value: 46.45, display: '46.45 ms', packages: '31', noop: '19.18 ms', className: 'is-knot' },
  { tool: 'Bun', value: 39.38, display: '39.38 ms', packages: '29', noop: '20.48 ms', className: 'is-bun' },
  { tool: 'pnpm', value: 550.56, display: '550.56 ms', packages: '29', noop: '339.88 ms', className: 'is-pnpm' },
  { tool: 'npm', value: 915.21, display: '915.21 ms', packages: '29', noop: '288.44 ms', className: 'is-npm' },
];

const maxBenchmark = 915.21;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Knot is a native JavaScript toolchain for installing dependencies, transforming TypeScript, and building for Node.js and browsers." />
    <meta name="theme-color" content="#070b0b" />
    <title>Knot — native JavaScript tooling</title>
    <link rel="icon" type="image/png" href={`${base}/assets/knot-icon.png`} />
    <link rel="apple-touch-icon" href={`${base}/assets/knot-icon.png`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href={`${base}#top`} aria-label="Knot home">
          <span class="brand-mark"><img src={`${base}/assets/knot-icon.png`} alt="" /></span>
          <span class="brand-name">knot<span class="brand-cursor">_</span></span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href={`${base}#features`}>Features</a>
          <a href={`${base}#benchmarks`}>Benchmarks</a>
          <a href={`${base}#roadmap`}>Roadmap</a>
          <a href={`${repoUrl}`} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
        <a class="nav-cta" href={`${base}#install`}>Get started <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <main id="main">
      <section class="hero section-pad" id="top">
        <div class="hero-grid container">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot"></span> Native tooling for Node.js projects</p>
            <h1>Move the whole toolchain <em>closer to the metal.</em></h1>
            <p class="hero-lede">Install dependencies, transform TypeScript, and build for Node.js or the browser with a native CLI. Knot does not ship its own JavaScript VM; generated code runs in the runtime you choose.</p>
            <div class="hero-actions">
              <a class="button button-primary" href={`${base}#install`}>Install Knot <span aria-hidden="true">→</span></a>
              <a class="button button-quiet" href={`${repoUrl}`} target="_blank" rel="noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>
            </div>
            <div class="hero-proof">
              <span><strong>Native CLI</strong> Bend2 core</span>
              <span><strong>CPU-first</strong> required path</span>
              <span><strong>Node.js + browser</strong> output</span>
            </div>
          </div>
          <div class="hero-console" role="img" aria-label="Knot terminal preview">
            <div class="console-top"><span class="console-lights"><i></i><i></i><i></i></span><span>~/projects/app</span><span class="console-dim">knot</span></div>
            <div class="console-body">
              <p><span class="console-prompt">$</span> knot install</p>
              <p class="console-muted">resolving package graph</p>
              <p class="console-muted">verifying integrity</p>
              <p><span class="console-check">✓</span> 31 packages linked</p>
              <p class="console-gap"></p>
              <p><span class="console-prompt">$</span> knot build src/main.ts</p>
              <p><span class="console-check">✓</span> dist/main.js written</p>
              <span class="console-caret" aria-hidden="true"></span>
            </div>
            <div class="console-foot"><span>deterministic output</span><span>runtime stays external</span></div>
          </div>
        </div>
        <div class="hero-grid-lines" aria-hidden="true"></div>
      </section>

      <section class="statement section-pad">
        <div class="container statement-grid">
          <p class="section-kicker">01 / The premise</p>
          <div>
            <h2>One native CLI from dependencies to output.</h2>
            <div class="workflow-line"><span>knot install</span><b>→</b><span>knot transpile</span><b>→</b><span>knot build</span></div>
            <p class="body-copy">Resolve dependencies once, transform source locally, and emit deterministic JavaScript. Node.js or the browser remains responsible for execution.</p>
            <div class="statement-points">
              <div><strong>Resolve once</strong><span>Verified downloads, lockfiles, and isolated links.</span></div>
              <div><strong>Transform locally</strong><span>Supported TypeScript and JSX become JavaScript with source maps.</span></div>
              <div><strong>Execute elsewhere</strong><span>Generated output runs in Node.js or the browser.</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="features section-pad" id="features">
        <div class="container">
          <div class="section-heading">
            <div><p class="section-kicker">02 / What exists today</p><h2>The core ships in layers.</h2></div>
            <p>Package management and a compiler subset are available now. Bundling and testing are still in progress.</p>
          </div>
          <div class="feature-grid">
            {features.map((feature) => (
              <article class="feature-card">
                <div class="feature-card-top"><span class="feature-number">{feature.number}</span><span class={`status ${feature.status === 'Available now' ? 'status-live' : ''}`}>{feature.status}</span></div>
                <h3>{feature.title}</h3>
                <p>{feature.copy}</p>
                <code>{feature.command}</code>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="benchmarks section-pad" id="benchmarks">
        <div class="container">
          <div class="section-heading benchmark-heading">
            <div><p class="section-kicker">03 / Measured, not promised</p><h2>One fixture. Four installers.</h2></div>
            <p>One combined view of cached installs on the same manifest. Lower is faster; each manager keeps its own lockfile.</p>
          </div>
          <div class="benchmark-layout">
            <div class="chart-card">
              <div class="chart-head"><span>Cached install after deleting node_modules <small>lower is better</small></span><span class="chart-unit">milliseconds</span></div>
              <div class="bar-chart" role="img" aria-label="Bar chart comparing cached install times: Knot 46.45 milliseconds, Bun 39.38 milliseconds, pnpm 550.56 milliseconds, and npm 915.21 milliseconds.">
                {benchmarkRows.map((row) => (
                  <div class="bar-row">
                    <div class="bar-label"><strong>{row.tool}</strong><span>median · {row.packages} packages</span></div>
                    <div class="bar-track"><span class={`bar ${row.className}`} style={`--bar-width: ${(row.value / maxBenchmark) * 100}%`}></span></div>
                    <strong class="bar-value">{row.display}</strong>
                  </div>
                ))}
              </div>
              <div class="chart-legend"><span><i class="legend-dot knot-dot"></i>Knot</span><span><i class="legend-dot bun-dot"></i>Bun</span><span><i class="legend-dot pnpm-dot"></i>pnpm</span><span><i class="legend-dot npm-dot"></i>npm</span></div>
            </div>
            <div class="benchmark-callout">
              <span class="callout-label">Fastest reported median</span>
              <strong>Bun</strong>
              <div class="callout-values"><span><b>39.38</b>Bun</span><span><b>46.45</b>Knot</span></div>
              <p>Bun was 7.07 ms faster than Knot in this run. All tools used the same package manifest, but each generated its own lockfile and resolved graph.</p>
              <a href={`${repoUrl}/blob/main/benchmark/package-manager/all-comparison.md`} target="_blank" rel="noreferrer">Read the methodology <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="benchmark-table-wrap">
            <table>
              <caption>Unified cached install measurements from 2026-09-27.</caption>
              <thead><tr><th scope="col">Tool</th><th scope="col">Median</th><th scope="col">Packages</th><th scope="col">No-op install</th></tr></thead>
              <tbody>
                {benchmarkRows.map((row) => (
                  <tr class={row.tool === 'Knot' ? 'table-highlight' : ''}><th scope="row">{row.tool}</th><td>{row.display}</td><td>{row.packages}</td><td>{row.noop}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <details class="methodology"><summary>Benchmark scope and limits</summary><p>The fixture manifest was identical for every tool. Each run used warm caches, a separate temporary directory, and five timed installs after deleting node_modules. These measurements do not cover cold caches, first registry resolution, lifecycle scripts, workspaces, or identical lock graphs across tools.</p></details>
        </div>
      </section>

      <section class="install section-pad" id="install">
        <div class="container">
          <div class="install-grid">
            <div>
              <p class="section-kicker">04 / Install</p>
              <h2>Install Knot.<br /><em>Keep your workflow.</em></h2>
              <p class="body-copy">Knot 0.0.1 is published as <code>@matheusbbarni/knot</code>. The published launcher requires Node.js 18 or newer. Use the source build only when you need the latest repository changes.</p>
              <a class="text-link" href={`${repoUrl}/blob/main/README.md`} target="_blank" rel="noreferrer">Read the release status <span aria-hidden="true">↗</span></a>
            </div>
            <div class="install-terminal">
              <div class="install-terminal-label">Published package · v0.0.1</div>
              <div class="registry-command"><span>npm</span><code>npm install --global @matheusbbarni/knot</code><button class="copy-command" type="button" data-copy="npm install --global @matheusbbarni/knot">Copy</button></div>
              <div class="registry-command"><span>Bun</span><code>bun add --global @matheusbbarni/knot</code><button class="copy-command" type="button" data-copy="bun add --global @matheusbbarni/knot">Copy</button></div>
              <div class="registry-command"><span>pnpm</span><code>pnpm add --global @matheusbbarni/knot</code><button class="copy-command" type="button" data-copy="pnpm add --global @matheusbbarni/knot">Copy</button></div>
            </div>
          </div>
        </div>
      </section>

      <section class="roadmap section-pad" id="roadmap">
        <div class="container">
          <div class="section-heading"><div><p class="section-kicker">05 / Next features</p><h2>What comes next.</h2></div><p>The dependable core ships first. Broader bundling and test execution follow the same native, deterministic path.</p></div>
          <div class="roadmap-list">
            {roadmap.map((item, index) => (
              <article class={`roadmap-item ${index === 1 ? 'roadmap-current' : ''}`}>
                <span class="roadmap-phase">{item.phase}</span>
                <div><h3>{item.title}</h3><p>{item.copy}</p></div>
                <span class="roadmap-arrow" aria-hidden="true">↗</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="closing section-pad">
        <div class="container closing-inner">
          <img src={`${base}/assets/knot-logo.png`} alt="Knot mark" width="128" height="96" loading="lazy" />
          <p class="section-kicker">The native JavaScript toolchain</p>
          <h2>Install once.<br /><em>Build with one tool.</em></h2>
          <div class="hero-actions"><a class="button button-primary" href={`${base}#install`}>Install Knot <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-wrap"><a class="brand" href={`${base}#top`}><span class="brand-mark"><img src={`${base}/assets/knot-icon.png`} alt="" /></span><span class="brand-name">knot<span class="brand-cursor">_</span></span></a><p>Apache-2.0 · Built in Bend2</p><a href={`${repoUrl}`} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a></div>
    </footer>

    <script>
      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const command = button.getAttribute('data-copy');
          if (!command || !navigator.clipboard) return;
          try {
            await navigator.clipboard.writeText(command);
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Copy failed';
          }
          window.setTimeout(() => { button.textContent = 'Copy'; }, 1600);
        });
      });
    </script>
  </body>
</html>
